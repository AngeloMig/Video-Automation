# Copy to .env.local. Only NEXT_PUBLIC_ values reach the browser, and the app reports the others
# as configured or not without ever showing their values.

# ---- Required ----
# Local: the value below works with `pnpm db:local`.
# Production: Supabase > Project settings > Database > Connection string (transaction pooler).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/video_automation

# Development sign-in only. Any long random string. Ignored once Supabase is configured.
LOCAL_AUTH_SECRET=change-me-to-a-long-random-string

# ---- Auth (required in production) ----
# Without these the app uses development sign-in, which refuses to run in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Storage (required in production) ----
# Cloudflare R2 or any S3-compatible store. Without these, files go to .data/storage.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# LOCAL_STORAGE_DIR=.data/storage

# ---- AI: scripts, research, scoring, highlights, transcription ----
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_MODEL=tts-1
# Used for cost estimates. Set these to your model's current prices.
# OPENAI_INPUT_USD_PER_MTOK=0.15
# OPENAI_OUTPUT_USD_PER_MTOK=0.60

# ---- Voice ----
# Picks automatically: ElevenLabs, then OpenAI, then this Mac's voices in development.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Default order: ElevenLabs, then OpenAI, then Kokoro (free, runs on the worker, no key).
# Set this to keep Kokoro after adding an OpenAI key. macos-say is for testing only.
# TTS_PROVIDER=kokoro

# ---- Licensed B-roll ----
# Without a key, scenes use typographic cards. Pexels wins if both are set.
# Free at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Pexels has paused new keys (seen November 2026). An existing key still works here.
PEXELS_API_KEY=

# ---- Discovery ----
# YouTube Data API v3: metadata only.
YOUTUBE_API_KEY=

# ---- Worker and rendering ----
# WORKER_CONCURRENCY=1
# RENDER_CONCURRENCY=
# FFMPEG_PATH=
# FFPROBE_PATH=
# DATABASE_POOL_SIZE=10

# ---- Later phases: not read by the app yet ----
# TOKEN_ENCRYPTION_KEY=   # Phase 2: 32 bytes, base64. Encrypts social OAuth tokens.
# META_APP_ID=            # Phase 2
# META_APP_SECRET=        # Phase 2
# STRIPE_SECRET_KEY=      # Phase 4
# STRIPE_WEBHOOK_SECRET=  # Phase 4
